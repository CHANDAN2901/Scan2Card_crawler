# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration - Only these origins can access the crawler service
ALLOWED_ORIGINS=https://ji4rruehim.ap-south-1.awsapprunner.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Self-Ping URL (for keeping Render service warm)
SELF_PING_URL=https://scan2card-crawler.onrender.com/api/health
